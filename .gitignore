# R files
.Rproj.user/
.Rhistory
.RData
.Ruserdata
renv/library/
*.rds
.renv/
inst/doc
doc/
Meta/
.quarto/

# Data files
*.csv
*.xlsx
*.xls
*.docx
*.RData
*.pdf

# Excepcion: resultados agregados del benchmark ciecl (sin datos sensibles)
!benchmark/*.csv

# Generated output
/output_qmd/
resultados_tesis/*
# Las carpetas resultados_tesis/ de trabajo bajo analisis/ siguen ignoradas
# (la regla anterior sin ancla las cubria; se mantiene ese comportamiento)
analisis/*/resultados_tesis/
# Artefactos de render de knitr (figuras sueltas; las de registro van embebidas en HTML)
analisis/*/figure/
/grafico_pertenencia_modular_files/

# Sensitive data
/data/
/Lock_sensible/
/DATOS ABIERTOS/
/ICD_2019/
/TEST_funciones_files/
/.vscode/
/_extensions/
/DOCUMENTOS TESIS/

# Archivos historicos/experimentales
/archivo/

# Archivos temporales de Claude Code
tmpclaude-*

# Obsidian vault
.obsidian/

# Quarto output files
*_files/

# R Markdown intermediate
*.rmarkdown

# Python virtual environment
.venv/

# System files
.DS_Store
__pycache__/
*.pyc
# IDE/Tool config
.claude/
CLAUDE.md

# HTML outputs (regenerables desde .qmd)
*.html

# Test files
test_*.R

# Windows null device
nul
html/

# Archivos temporales de trabajo (checks, scripts auxiliares, volcados)
temp_*
temp_read/
99_TEMP/
**/99_TEMP/
_*.R
_*.py
*_check.md
.adversarial_report.json
.gemini_diagnostic.json
gemini.md

# Estado interno de herramientas de agente (equivalente a .claude/)
.pi/

# Diagnosticos puntuales y logs de render (resultados ya registrados en memoria)
diag_*
render_*.log
render_log.txt

# Excepcion: solo resultados_tesis/VIGENTES/ es publicable (va al final para
# prevalecer sobre las reglas globales *.csv, *.docx y *.html)
!resultados_tesis/VIGENTES/
!resultados_tesis/VIGENTES/**
